+    fn interval(&mut self, _team: &crate::search::Team, totals: crate::search::Totals) -> (f64, f64) {
+        let value = self.value(totals.power); (value, value)
+    }
+    fn exact(&mut self, _team: &crate::search::Team, power: f64, _slots: &[f64]) -> Result<crate::search::Exact, String> {
