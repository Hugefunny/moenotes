+fn power_reward_candidates(original:&[crate::search::Hit],reranked:&[crate::search::Hit],target:f64,k:usize)->Vec<crate::search::Hit> {
+    let mut hits=original.iter().cloned().chain(reranked.iter().filter(|hit|hit.key>=0.0).cloned()
+        .map(|mut hit|{hit.key=target;hit})).collect::<Vec<_>>();
+    hits.sort_by(|a,b|b.power.total_cmp(&a.power).then_with(||a.team.members.cmp(&b.team.members)).then_with(||a.team.snaps.cmp(&b.team.snaps)));
+    let mut seen=std::collections::BTreeSet::new();
+    hits.into_iter().filter(|hit|{let mut ids=hit.team.members.clone();ids.sort_unstable();seen.insert(ids)}).take(k).collect()
+}
