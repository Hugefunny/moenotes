+pub fn compare_reward_keys(a: &Value, b: &Value) -> std::cmp::Ordering {
+    let values = |v: &Value| crate::master::rows(v).iter().map(|v| v.as_str().unwrap().parse::<i128>().unwrap()).collect::<Vec<_>>();
+    values(a).cmp(&values(b))
+}
