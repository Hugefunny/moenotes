+// Moenotes Skip CP is a fixed result-grade payoff, independent of the formation.
+pub struct FixedChallengePoints { pub value: f64, pub master: Master, pub chart: Chart }
+impl Objective for FixedChallengePoints {
+    fn canonical_leader(&self) -> bool { true }
+    fn preserve_snap_options(&self) -> bool { true }
+    fn skill(&mut self, _: usize, _: i32) -> (f64, f64) { (0.0, 0.0) }
+    fn bound(&mut self, _: Totals) -> f64 { self.value }
+    fn interval(&mut self, _: &Team, _: Totals) -> (f64, f64) { (self.value, self.value) }
+    fn exact(&mut self, _: &Team, power: f64, _: &[f64]) -> Result<Exact, String> {
+        Ok(Exact { key: self.value, detail: json!({"skipScore":chart::skip_score(&self.master, &self.chart, power as i32),"mean":self.value,"rewardSum":self.value,"orders":1,"bonus":0,"challengePoints":self.value}) })
+    }
+}
