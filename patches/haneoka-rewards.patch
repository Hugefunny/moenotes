+impl LexRewards {
+    fn optimistic(&self, high: f64, bonuses: [f64; 2]) -> Vec<i128> {
+        let mut vector = vec![i128::MIN; self.levels.len()];
+        for &(rank, required) in &self.eligible {
+            if rank > 2 && !high.is_nan() && required as f64 > high { continue; }
+            let values = std::array::from_fn(|kind| {
+                if !self.used[kind] { 0 }
+                else if kind < 2 && !self.monotone[kind] { 214748 }
+                else { self.reward(kind, bonuses[kind.min(1)].ceil(), rank) as i128 }
+            });
+            for (upper, level) in vector.iter_mut().zip(&self.levels) {
+                *upper = (*upper).max(self.sum(level, &values) * self.observations as i128);
+            }
+        }
+        vector
+    }
+    fn projected_bound(&self, high: f64, bonuses: [f64; 2]) -> f64 {
+        let upper = self.optimistic(high, bonuses);
+        if self.frontier.as_ref().is_some_and(|kth| upper <= *kth) { f64::NEG_INFINITY }
+        else { (upper[self.search_level] as f64).next_up() }
+    }
+    fn member_bonuses(&self, members: &[usize], left: usize, from: usize) -> [f64; 2] {
+        std::array::from_fn(|kind| members.iter().map(|&m|self.members[kind][m]).sum::<f64>()
+            + self.member_suffix[kind][from][left] + self.snap_top[kind])
+    }
+    fn assignment_bonuses(&mut self, members: &[usize], assigned: &[i32], from: usize, matching: bool) -> [f64; 2] {
+        let used = assigned[..from].iter().filter(|&&s|s>=0).copied().collect::<Vec<_>>();
+        std::array::from_fn(|kind| {
+            let base = members.iter().map(|&m|self.members[kind][m]).sum::<f64>()
+                + used.iter().map(|&s|self.snaps[kind][s as usize]).sum::<f64>();
+            if from == 5 || !self.used[kind] || !self.monotone[kind] { return base; }
+            if matching {
+                let width = self.snaps[kind].len();
+                let rows = (from..5).map(|slot| {
+                    let mut row = vec![-1e15; width + 5 - from];
+                    for &s in &self.options[slot] {
+                        if s < 0 { row[width + slot - from] = 0.0; }
+                        else if !used.contains(&s) { row[s as usize] = self.snaps[kind][s as usize]; }
+                    }
+                    row
+                }).collect::<Vec<_>>();
+                base + self.matching.maximum(&rows, width + 5 - from, None)
+            } else {
+                base + (from..5).map(|slot| self.options[slot].iter()
+                    .filter(|s| !used.contains(s)).map(|&s|if s<0 {0.0} else {self.snaps[kind][s as usize]})
+                    .fold(f64::NEG_INFINITY, f64::max)).sum::<f64>()
+            }
+        })
+    }
+
+    pub fn new(master: &Master, members: &[Member], snaps: &[Snap], chart: &Chart, route: Route,
+        play: &Value, levels: &Value, score_cap: f64) -> Result<Self, String> {
+        let levels: Vec<Vec<RewardTerm>> = serde_json::from_value(levels.clone()).map_err(|e| e.to_string())?;
+        if levels.is_empty() || levels.len() > 3 || levels.iter().any(|l| l.is_empty())
+            || levels.iter().map(Vec::len).sum::<usize>() > 9
+            || levels.iter().flatten().any(|t| t.kind > 2 || t.weight < 1 || t.weight > 1_000_000_000) {
+            return Err("combined-reward-levels".into());
+        }
+        let used = std::array::from_fn(|kind| levels.iter().flatten().any(|t| t.kind == kind));
+        let bonuses = |kind: usize| members.iter().map(|m| if used[kind] { power::member_event_percent(&route.effects,m,kind as i32) as f64 } else { 0.0 }).collect::<Vec<_>>();
+        let support = |kind: usize| snaps.iter().map(|s| if used[kind] { power::snap_event_percent(&route.effects,s,kind as i32) as f64 } else { 0.0 }).collect::<Vec<_>>();
+        let member_bonus = [bonuses(0),bonuses(1)];
+        let snap_bonus = [support(0),support(1)];
+        let monotone=std::array::from_fn(|kind| member_bonus[kind].iter().chain(&snap_bonus[kind]).all(|v|*v>=0.0));
+        let max_bonus = std::array::from_fn(|kind| top_character_bonus(members,&member_bonus[kind]) + top_five(snap_bonus[kind].iter().copied()));
+        let played = route.kind != RouteKind::Skip;
+        let eligible = if played {
+            std::iter::once((2,0)).chain(chart.ranks.iter().filter(|r| r.rank > 2 && r.required as f64 <= score_cap).map(|r|(r.rank,r.required))).collect::<Vec<_>>()
+        } else { vec![(master.params.skip_rank,0)] };
+        let observations = if played { 120 } else { 1 };
+        let selected = levels.iter().flatten().find(|t| t.kind < 2).map_or(0,|t|t.kind);
+        let mut out = Self { master:master.clone(),chart:chart.clone(),core:played.then(||LiveCore::new(master,chart,members,snaps,play)),route,levels,used,
+            members:member_bonus,snaps:snap_bonus,selected,max_bonus,monotone,eligible,observations,search_level:0,primary_upper:0,constant:false, member_suffix:std::array::from_fn(|_|Vec::new()),
+            snap_top:[0.0;2],
+            frontier:None, options:Vec::new(), matching:crate::assignment::Scratch::default() };
+        out.snap_top=std::array::from_fn(|kind|top_five(out.snaps[kind].iter().map(|v|v.max(0.0))));
+        out.check_domain()?;
+        let (low, high) = out.global_range()?;
+        out.primary_upper = out.sum(&out.levels[0],&high) * observations as i128;
+        out.search_level = out.levels.iter().position(|level|out.sum(level,&low) != out.sum(level,&high)).unwrap_or(0);
+        out.selected = out.levels[out.search_level].iter().find(|term| term.kind < 2).map_or(out.selected, |term| term.kind);
+        out.constant = out.levels.iter().all(|level|out.sum(level,&low) == out.sum(level,&high));
+        Ok(out)
+    }
+    fn reward(&self, kind: usize, bonus: f64, rank: i32) -> f64 {
+        match kind { 0=>self.route.points(bonus,rank),1=>self.route.items(bonus,rank),_=>self.route.cp(rank) }
+    }
+    fn whole(value: f64) -> Result<i128,String> {
+        if !value.is_finite() || value.fract() != 0.0 || value < i32::MIN as f64 || value > i32::MAX as f64 {
+            return Err("combined-reward-range".into());
+        }
+        Ok(value as i128)
+    }
+    fn check_domain(&mut self) -> Result<(),String> {
+        let rate=Self::whole(self.route.rate)?;
+        let item_rate=Self::whole(self.route.reward_rate)?;
+        for &(rank,_) in &self.eligible {
+            let row=self.route.rank_row(rank);
+            if self.used[0] {
+                let base=row.map_or(0,|r|r.points) as i128;
+                let bonus=(self.max_bonus[0]+10000.0) as i128;
+                let first=if self.route.kind==RouteKind::Challenge {base*rate} else {bonus*rate};
+                self.monotone[0] &= base>=0 && rate>=0 && bonus<=i32::MAX as i128 && (base==0 || first<=i32::MAX as i128 && base*rate*bonus<=i32::MAX as i128);
+            }
+            if self.used[1] {
+                if row.is_some_and(|r|r.items.len()>1) {return Err("combined-item-lottery".into());}
+                for &(count,probability) in row.map(|r|r.items.as_slice()).unwrap_or_default() {
+                    if probability!=10000.0 {return Err("combined-item-lottery".into());}
+                    let bonus=(self.max_bonus[1]+10000.0) as i128;
+                    self.monotone[1] &= count>=0 && item_rate>=0 && bonus<=i32::MAX as i128 && count as i128*bonus*item_rate<=i32::MAX as i128;
+                }
+            }
+            for kind in 0..3 { if self.used[kind] { Self::whole(self.reward(kind,self.max_bonus[kind.min(1)],rank))?; } }
+        }
+        Ok(())
+    }
+    fn global_range(&self) -> Result<([i128;3],[i128;3]),String> {
+        let mut low=[i128::MAX;3];let mut high=[0;3];
+        for &(rank,_) in &self.eligible { for kind in 0..3 { if self.used[kind] {
+            if kind<2 && !self.monotone[kind] {low[kind]=-214748;high[kind]=214748;}else{
+                low[kind]=low[kind].min(Self::whole(self.reward(kind,0.0,rank))?);
+                high[kind]=high[kind].max(Self::whole(self.reward(kind,self.max_bonus[kind.min(1)],rank))?);
+            }
+        } } }
+        for kind in 0..3 { if !self.used[kind] {low[kind]=0;} }
+        Ok((low,high))
+    }
+    fn sum(&self, level: &[RewardTerm], values: &[i128;3]) -> i128 {
+        level.iter().map(|t|values[t.kind]*t.weight).sum()
+    }
+    fn team_bonus(&self,team:&Team,kind:usize)->f64 {
+        team.members.iter().map(|&m|self.members[kind][m]).sum::<f64>()
+            + team.snaps.iter().filter(|&&s|s>=0).map(|&s|self.snaps[kind][s as usize]).sum::<f64>()
+    }
+}
