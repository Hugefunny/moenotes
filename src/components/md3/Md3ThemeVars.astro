---
/**
 * MUI's theme CSS variables (both color schemes), once per page. Islands render their Md3Provider with
 * `disableStyleSheetGeneration`, so this is the only copy.
 */
import { md3ThemeVariablesCss } from "@/components/md3/Md3Provider";

const css = `@layer mui{${md3ThemeVariablesCss()}}`;
---

<style is:inline data-md3-theme-vars set:html={css}></style>
