---
import PageLayout from "@/layouts/PageLayout.astro";
import type { AppLocale } from "@/config/locales";
import { siteConfig, haneokaUrl, haneokaEngineDocument } from "@/config/site";
import { t } from "@/i18n";
import { HANEOKA_COMMIT } from "@/lib/deck/haneoka/request";
import { getLegalTexts } from "@/i18n/legal";

export type LegalDocument = "license" | "terms" | "privacy";

interface Props {
  locale: AppLocale;
  document: LegalDocument;
}

const { locale, document } = Astro.props;
const texts = getLegalTexts(locale);
const doc = texts.documents[document];
const updated = new Intl.DateTimeFormat(locale, { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }).format(Date.parse(`${texts.updated}T00:00:00Z`));
const repo = siteConfig.repository ?? "";
// `{repo}` marks where the repository link goes.
const parts = (text: string) => text.split("{repo}");
---

<PageLayout locale={locale} titleKey={`seo.${document}.title`} descriptionKey={`seo.${document}.description`}>
  <article class="md3-surface max-w-4xl p-5 sm:p-8">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-body-small text-on-surface-variant">
      <time datetime={texts.updated}>{texts.updatedLabel.replace("{date}", updated)}</time>
      <span class="opacity-70">{texts.draftNotice}</span>
    </p>
    <div class="mt-6 space-y-8">
      {doc.sections.map((section) => (
        <section>
          <h2 class="font-[var(--md-ref-typeface-brand)] text-title-large text-on-surface">{section.title}</h2>
          {section.paragraphs?.map((paragraph) => (
            <p class="mt-3 text-body-medium leading-7 text-on-surface-variant">
              {parts(paragraph).map((chunk, index) => (
                <>
                  {index > 0 && repo && <a href={repo} target="_blank" rel="noopener noreferrer" class="break-all font-bold text-primary underline underline-offset-4">{repo}</a>}
                  {chunk}
                </>
              ))}
            </p>
          ))}
          {section.items && (
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-body-medium leading-7 text-on-surface-variant">
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>
    {document === "license" && <p class="mt-6 text-body-medium leading-7 text-on-surface-variant">
      {t(locale, "deckWorkspace.solver.haneokaAttribution")} — <a href={haneokaUrl} class="text-primary underline">{haneokaUrl}</a>
      {" · AGPL-3.0-only · "}<a href={haneokaEngineDocument(HANEOKA_COMMIT, "LICENSE")} class="text-primary underline">LICENSE</a>
      {" · "}<a href={haneokaEngineDocument(HANEOKA_COMMIT, "NOTICE")} class="text-primary underline">NOTICE</a>
    </p>}
  </article>
</PageLayout>
