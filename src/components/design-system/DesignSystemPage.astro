---
import DesignSystemPage from "./DesignSystemPage";
import type { AppLocale } from "@/config/locales";
import { getBuildThemeBands } from "@/lib/masterdata/build-settings";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
// The band colors the settings offer, so the gallery previews the same seeds.
const bands = await getBuildThemeBands(locale);
---

<DesignSystemPage client:load locale={locale} bands={bands} />
