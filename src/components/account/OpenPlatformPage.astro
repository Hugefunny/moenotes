---
import PageLayout from "@/layouts/PageLayout.astro";
import OpenPlatformPanel from "@/components/account/OpenPlatformPanel";
import type { AppLocale } from "@/config/locales";
import { t } from "@/i18n";
import { openPlatformDocsUrl } from "@/config/site";

interface Props { locale: AppLocale }
const { locale } = Astro.props;
---
<PageLayout locale={locale} titleKey="openPlatform.title" descriptionKey="openPlatform.pageDescription">
  <section class="md3-surface mb-6 p-4 sm:p-6 md:p-8">
    <a class="mn-list-card md3-card-outlined relative flex items-center justify-between gap-4 p-5" href={openPlatformDocsUrl}>
      <span><span class="block font-[var(--md-ref-typeface-brand)] text-title-large">{t(locale, "openPlatform.docs.title")}</span><span class="mt-1 block text-body-medium text-on-surface-variant">{t(locale, "openPlatform.docs.description")}</span></span>
      <span aria-hidden="true" class="shrink-0 text-headline-small text-primary">→</span>
    </a>
  </section>
  <OpenPlatformPanel client:load locale={locale} />
</PageLayout>
