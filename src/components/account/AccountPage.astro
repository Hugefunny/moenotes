---
import PageLayout from "@/layouts/PageLayout.astro";
import AccountPanel from "@/components/account/AccountPanel";
import type { AppLocale } from "@/config/locales";
import { getAvatarBands } from "@/lib/account/avatar-options";
import { getProfileCards } from "@/lib/account/profile-cards";
import { t } from "@/i18n";
import { localizePath } from "@/i18n/routing";
import { getRoutePathById } from "@/lib/route/registry";

interface Props {
  locale: AppLocale;
}

const { locale } = Astro.props;
const [bands, cards] = await Promise.all([getAvatarBands(locale), getProfileCards(locale)]);
---

<PageLayout locale={locale} titleKey="account.title" descriptionKey="account.description">
  <a href={localizePath(getRoutePathById("card-box"), locale)} class="md3-button md3-button--outlined mb-5">{t(locale, "deckWorkspace.boxTitle")}</a>
  <AccountPanel client:load locale={locale} bands={bands} cards={cards} />
</PageLayout>
