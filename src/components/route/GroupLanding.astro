---
import RouteGlyph from "@/components/shared/RouteGlyph";
import type { AppLocale } from "@/config/locales";
import { t } from "@/i18n";
import { localizePath } from "@/i18n/routing";
import { getBuildCatalogCounts, getBuildCatalogCovers } from "@/lib/masterdata/build-catalog";
import { getNavChildren } from "@/lib/route/registry";
import type { AppRoute } from "@/types/route";

interface Props {
  locale: AppLocale;
  group: AppRoute;
}

const { locale, group } = Astro.props;
const children = getNavChildren(group);
const [counts, covers] = await Promise.all([getBuildCatalogCounts(locale), getBuildCatalogCovers(locale)]);
// Collections show their newest entry; tools and pages without a picture follow as a list.
const pictured = children.filter((item) => covers[item.id]);
const listed = children.filter((item) => !covers[item.id]);
---

{/* Each collection as a picture of its newest entry with how many it lists; each tool as its icon and what it does. */}
<section>
  {t(locale, "page.groupIntro") ? (
    <p class="mb-6 max-w-3xl text-body-large text-on-surface-variant">{t(locale, "page.groupIntro")}</p>
  ) : null}
  {pictured.length > 0 ? (
    <ul class="grid grid-cols-2 gap-x-3 gap-y-5 sm:gap-x-4 sm:gap-y-7 lg:grid-cols-3 2xl:grid-cols-4">
      {pictured.map((item) => {
        const cover = covers[item.id]!;
        const count = counts[item.id];
        return (
          <li class="min-w-0">
            <a href={localizePath(item.path, locale)} class="mn-hub-tile group block rounded-shape-lg">
              <span class="mn-hub-cover relative block aspect-video overflow-hidden rounded-shape-lg bg-surface-container-high">
                <img
                  src={cover.url}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class={cover.fit === "contain" ? "absolute inset-0 m-auto max-h-full max-w-full object-contain p-6" : "h-full w-full object-cover object-[50%_25%]"}
                />
              </span>
              <span class="mt-2 flex flex-wrap items-baseline justify-between gap-x-3 px-1 sm:mt-3">
                <h2 class="min-w-0 truncate text-title-medium text-on-surface group-hover:text-primary sm:text-title-large">{t(locale, item.labelKey)}</h2>
                {count ? <span class="shrink-0 text-label-large tabular-nums text-on-surface-variant">{t(locale, "filter.total", { total: count.toLocaleString(locale) })}</span> : null}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  ) : null}
  {listed.length > 0 ? (
    <ul class={`grid gap-3 sm:grid-cols-2 lg:grid-cols-3 ${pictured.length > 0 ? "mt-10" : ""}`}>
      {listed.map((item) => (
        <li class="min-w-0">
          <a href={localizePath(item.path, locale)} class="md3-state flex h-full items-start gap-4 rounded-shape-lg bg-surface-container-low p-4">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-secondary-container text-on-secondary-container">
              <RouteGlyph icon={item.nav && item.nav.icon ? item.nav.icon : "sparkles"} routeId={item.id} className="h-6 w-6" />
            </span>
            <span class="min-w-0">
              <h2 class="text-title-medium text-on-surface">{t(locale, item.labelKey)}</h2>
              <p class="mt-1 line-clamp-2 text-body-medium text-on-surface-variant">{t(locale, item.seo.descriptionKey)}</p>
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : null}
</section>
