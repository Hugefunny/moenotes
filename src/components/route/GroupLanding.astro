---
import type { AppLocale } from "@/config/locales";
import { t } from "@/i18n";
import { localizePath } from "@/i18n/routing";
import { getNavChildren } from "@/lib/route/registry";
import type { AppRoute } from "@/types/route";

interface Props {
  locale: AppLocale;
  group: AppRoute;
}

const { locale, group } = Astro.props;
const children = getNavChildren(group);
---

<section>
  {t(locale, "page.groupIntro") ? (
    <p class="mb-6 max-w-3xl text-body-large text-on-surface-variant">{t(locale, "page.groupIntro")}</p>
  ) : null}
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {children.map((item) => (
      <a href={localizePath(item.path, locale)} class="md3-list-card group relative flex flex-col p-6">
        <h2 class="text-title-large text-on-surface">{t(locale, item.labelKey)}</h2>
        <p class="mt-2 flex-1 text-body-medium text-on-surface-variant">{t(locale, item.seo.descriptionKey)}</p>
        <span class="mt-5 inline-flex h-10 w-fit items-center gap-2 rounded-full bg-secondary-container px-4 text-label-large text-on-secondary-container">
          {t(locale, "actions.open")}
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
        </span>
      </a>
    ))}
  </div>
</section>
