---
import type { AppLocale } from "@/config/locales";
import { t } from "@/i18n";

interface Props {
  locale: AppLocale;
  titleKey: string;
  descriptionKey: string;
  showDescription?: boolean;
}

const { locale, titleKey, descriptionKey, showDescription = true } = Astro.props;
---

<header class="md3-page-heading">
  <div class="flex flex-wrap items-center gap-3">
    <h1>{t(locale, titleKey)}</h1>
    <slot name="title-badge" />
  </div>
  {showDescription ? <p>{t(locale, descriptionKey)}</p> : null}
</header>
<slot />
