---
import type { AppLocale } from "@/config/locales";
import { t } from "@/i18n";

interface Props {
  locale: AppLocale;
  titleKey: string;
  descriptionKey: string;
  showDescription?: boolean;
  /** The page renders its own heading (and h1), e.g. a detail page titled with the entity's name. */
  hideHeader?: boolean;
}

const { locale, titleKey, descriptionKey, showDescription = true, hideHeader = false } = Astro.props;
---

{!hideHeader && <header class="md3-page-heading">
  <div class="flex flex-wrap items-center gap-3">
    {/* The page's one accent: the seed as a highlighter under the title (MoeSekai's page header). */}
    <h1><span class="mn-brand-mark">{t(locale, titleKey)}</span></h1>
    <slot name="title-badge" />
  </div>
  {showDescription ? <p>{t(locale, descriptionKey)}</p> : null}
</header>}
<slot />
