---
import AppLayout from "@/layouts/AppLayout.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { t } from "@/i18n";
import { siteConfig } from "@/config/site";
import { getRoutePathById } from "@/lib/route/registry";
import { localizePath } from "@/i18n/routing";

const locale = "zh-CN" as const;
const pathname = "/404";
const homePath = localizePath(getRoutePathById("home"), locale);
const searchPath = localizePath(getRoutePathById("search"), locale);
---
<AppLayout locale={locale} pathname={pathname} meta={{ title: t(locale, "notFound.metaTitle"), description: t(locale, "notFound.description"), indexable: false }}>
  <div class="mx-auto w-full max-w-5xl py-4 sm:py-8">
    <PageLayout locale={locale} titleKey="notFound.title" descriptionKey="notFound.description" showDescription={false}>
      <section class="md3-surface relative overflow-hidden p-6 sm:p-8">
        <div class="grid items-center gap-6 sm:grid-cols-[minmax(0,1fr)_12rem] sm:gap-10">
          <div class="min-w-0">
            <p class="font-[var(--md-ref-typeface-brand)] text-display-large text-primary" aria-hidden="true">404</p>
            <p class="mt-5 max-w-xl text-body-large text-on-surface">{t(locale, "notFound.description")}</p>
            <p class="mt-3 max-w-xl text-body-medium text-on-surface-variant">{t(locale, "notFound.note")}</p>
          </div>
          <div class="hidden h-44 place-items-center rounded-shape-xl bg-secondary-container text-on-secondary-container sm:grid" aria-hidden="true">
            <svg class="h-20 w-20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V6l10-2v12" /><circle cx="6" cy="18" r="3" /><circle cx="16" cy="16" r="3" /></svg>
          </div>
        </div>
        <nav class="mt-8 grid gap-4 sm:grid-cols-2" aria-label={t(locale, "notFound.title")}>
          <a href={homePath} class="mn-list-card md3-card-outlined flex min-w-0 items-center gap-4 p-5 text-on-surface">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-secondary-container text-on-secondary-container" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M9 21v-9h6v9"/></svg></span>
            <span class="min-w-0 flex-1 text-title-medium">{t(locale, "notFound.home")}</span>
          </a>
          <a href={searchPath} class="mn-list-card md3-card-outlined flex min-w-0 items-center gap-4 p-5 text-on-surface">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-surface-container-highest text-on-surface-variant" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></span>
            <span class="min-w-0 flex-1 text-title-medium">{t(locale, "nav.items.search")}</span>
          </a>
        </nav>
      </section>
      <div class="mt-5 flex flex-wrap items-center gap-3 text-body-medium">
        <button type="button" onclick="window.location.reload()" class="md3-button md3-button--text">{t(locale, "actions.refresh")}</button>
        <a href={siteConfig.contact.bugReportUrl} target="_blank" rel="noopener noreferrer" class="md3-button md3-button--text">{t(locale, "notFound.feedback")}</a>
      </div>
    </PageLayout>
  </div>
</AppLayout>
